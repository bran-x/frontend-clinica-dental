{
  "openapi": "3.1.0",
  "info": {
    "title": "API Clínica Dental",
    "description": "Backend de demostración para una clínica dental.\n\n**Cómo probar desde Swagger:**\n1. `POST /auth/login` con `admin` / `admin123` (usuario creado por `seed.py`).\n2. Copiar el `access_token` de la respuesta.\n3. Pulsar **Authorize** arriba a la derecha y pegarlo.\n4. Los endpoints de pacientes y citas ya responden.",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Registrar un usuario",
        "description": "Abierto para facilitar la demo. En producción debería exigir rol admin.",
        "operationId": "register_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Iniciar sesión y obtener un token JWT",
        "description": "Enviar usuario y contraseña como formulario. Copiar el `access_token` en el botón *Authorize*.",
        "operationId": "login_auth_login_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_login_auth_login_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Token"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Autenticación"
        ],
        "summary": "Datos del usuario autenticado",
        "operationId": "me_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
